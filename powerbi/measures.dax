RETURN "vs prior month (" & FORMAT(Prior, "0.0%") & ")"

_Active Customers Delta Caption =

VAR net = [_Active Customers Net Change]
RETURN IF(net >= 0, "+", "") & FORMAT(net, "#,##0") & " net vs prior month"

_ARPA Delta Caption =
"vs prior month"

_Customer Growth Delta Caption =
"vs prior month"

_Logo Churn Delta Caption =
"vs prior month"

_NRR Delta Caption =
"vs prior month"

_Expansion Coverage Text =

"Expansion covered " & FORMAT ( [_Expansion to Churned MRR Ratio], "0%" ) & " of churned MRR this month."

_MRR by Plan MoM Delta Text =

VAR d = [_MRR by Plan MoM Delta]
RETURN IF ( d >= 0, "▲ +", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" )

_New Customers Delta Caption =

VAR Prior = CALCULATE ( [New Customers], DATEADD ( DimDate[Date], -1, MONTH ) )
RETURN "vs " & FORMAT ( Prior, "#,##0" )

_Churned Customers Delta Caption =

VAR Prior = CALCULATE ( [Churned Customers], DATEADD ( DimDate[Date], -1, MONTH ) )
RETURN "vs " & FORMAT ( Prior, "#,##0" )

