"vs prior month"


// =====================================================================
// ALT TEXT  (21 measures)
// Screen-reader alternative text for visuals (accessibility).
// =====================================================================

_Blended CAC Alt Text =
"Average cost to acquire a customer across channels, last 12 complete months: $" & FORMAT ( [Blended Marketing CAC (P4)], "#,0" )

_LTV Alt Text =
"Estimated lifetime value per customer, last 12 complete months: $" & FORMAT ( [Estimated LTV], "#,0" )

_LTVCAC Alt Text =
"Return on acquisition cost, last 12 complete months: " & FORMAT ( [Estimated LTV:CAC (P4)], "0.0" ) & " times"

_MRR Alt Text =
"$" & FORMAT ( [MRR], "#,0" ) & " in monthly recurring revenue."

_Payback Alt Text =
"Months to recover acquisition cost, last 12 complete months: " & FORMAT ( [Marketing CAC Payback (P4)], "0.0" )

_ARR Alt Text =
"$" & FORMAT ( [ARR], "#,0" ) & " in annualized revenue."

_Active Customers Alt Text =
FORMAT ( [Active Customers], "#,0" ) & " active customers."

_Logo Churn Alt Text =
FORMAT ( [Logo Churn Rate], "0.0%" ) & " of customers churned this month."

_Customer Growth Alt Text =

VAR pct = [Customer Growth %]
RETURN "Customer base " & IF ( pct >= 0, "growing ", "shrinking " ) & FORMAT ( ABS ( pct ), "0.0%" ) & " this month."

_NRR Alt Text =
FORMAT ( [NRR], "0.0%" ) & " of revenue retained including expansion."

_MRR Growth Alt Text =

VAR pct = [MRR Growth %]
RETURN "Revenue " & IF ( pct >= 0, "growing ", "shrinking " ) & FORMAT ( ABS ( pct ), "0.0%" ) & " month over month."

_ARPA Alt Text =
"$" & FORMAT ( [ARPA], "#,0.00" ) & " average revenue per account."

_Net MRR Change Alt Text =
"$" & FORMAT ( [Net MRR Change], "#,0" ) & " net revenue change this month."

_Gross New MRR Alt Text =
"$" & FORMAT ( [Gross New MRR], "#,0" ) & " in new and expanded revenue before losses."

_New Customers Alt Text =
FORMAT ( [New Customers], "#,0" ) & " new customers added this month."

_Churned Customers Alt Text =
FORMAT ( [Churned Customers], "#,0" ) & " customers lost this month."

_GRR Alt Text =
FORMAT ( [GRR], "0.0%" ) & " of revenue retained before counting expansion."

_Revenue Churn Rate Alt Text =
FORMAT ( [Revenue Churn Rate], "0.0%" ) & " of revenue lost to outright churn."

_MRR by Plan Alt Text =

VAR RankedPlans = 
    CALCULATETABLE (
        ADDCOLUMNS ( VALUES ( DimPlan[PlanName] ), "@MRR", [_MRR by Plan] ),
        ALLSELECTED ( DimPlan )
    )
VAR TopPlan = TOPN ( 1, RankedPlans, [@MRR], DESC )
VAR TopPlanName = CONCATENATEX ( TopPlan, DimPlan[PlanName] )
RETURN
    TopPlanName & " contributes the largest share of monthly revenue by plan."

_Churn by Reason Alt Text =

VAR RankedReasons = 
    CALCULATETABLE (
        ADDCOLUMNS ( VALUES ( FactSubscriptionEvent[ChurnReason] ), "@ChurnedMRR", [Churned MRR] ),
        ALLSELECTED ( FactSubscriptionEvent[ChurnReason] )
    )
VAR TopReason = TOPN ( 1, RankedReasons, ABS ( [@ChurnedMRR] ), DESC )
VAR TopReasonName = CONCATENATEX ( TopReason, FactSubscriptionEvent[ChurnReason] )
RETURN
    TopReasonName & " accounts for the largest share of revenue lost to churn."

_Churn by Plan Alt Text =

VAR RankedPlans = 
    CALCULATETABLE (
        ADDCOLUMNS ( VALUES ( DimPlan[PlanName] ), "@ChurnedMRR", [Churned MRR by Plan] ),
        ALLSELECTED ( DimPlan )
    )
VAR TopPlan = TOPN ( 1, RankedPlans, ABS ( [@ChurnedMRR] ), DESC )
VAR TopPlanName = CONCATENATEX ( TopPlan, DimPlan[PlanName] )
RETURN
    TopPlanName & " accounts for the largest share of revenue lost to churn."


